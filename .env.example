# AI Mesh — environment variables. Copy to .env (gitignored) and replace every
# `change-me` value. `make up` (WP0.1) refuses to start while placeholders remain.
# Synthetic data only; never put client data or real credentials here.

# --- Platform (mesh.core.settings.MeshSettings, prefix MESH_) ---------------------------
# PostgreSQL URL for the application role (INSERT/SELECT only on telemetry and audit).
MESH_DATABASE_URL=postgresql+psycopg://mesh_app:change-me@127.0.0.1:5432/mesh
# Qdrant endpoint and API key (the same key is given to the Qdrant container below).
MESH_QDRANT_URL=http://127.0.0.1:6333
MESH_QDRANT_API_KEY=change-me
# mesh-gateway endpoint as seen from the host.
MESH_GATEWAY_URL=http://127.0.0.1:8088
# Per-run artifacts (manifests, blobs). Gitignored.
MESH_RUNS_ROOT=runs
# Hidden test suites live OUTSIDE this repo (ground rule 3). Set by the human; the platform
# only passes it read-only to the judge. Leave empty until HC-04.
MESH_HIDDEN_ROOT=
# Approver SSH signing key: set only in the approver's own shell when running
# `mesh gate approve` (HC-09). Never set it here on a shared machine.
# MESH_APPROVER_SSH_KEY=

# --- Local infrastructure (infra/local/compose.yaml, WP0.1) ----------------------------
POSTGRES_PASSWORD=change-me
MESH_ADMIN_PASSWORD=change-me
MESH_APP_PASSWORD=change-me
QDRANT__SERVICE__API_KEY=change-me

# --- Gateway (WP0.4) -------------------------------------------------------------------
# Upstream Ollama as reached through the tunnel container.
MESH_GATEWAY_UPSTREAM=http://mesh-tunnel:11434
# live | record | replay (cassettes; see design/09-implementation-guide/04-test-strategy.md)
MESH_GATEWAY_MODE=live

# --- Tests -----------------------------------------------------------------------------
# Set to 1 only on machines without Docker; never set in CI.
MESH_ALLOW_SKIP_DOCKER=0
